# Safe middleware template. Runtime secrets and certificates stay outside Git.
VICIDIAL_ADAPTER_URL=https://edge.internal.codestra.agency:8443/restricted-vicidial
VICIDIAL_ADAPTER_CA_FILE=/run/secrets/vicidial-mtls/ca.crt
VICIDIAL_ADAPTER_CLIENT_CERT_FILE=/run/secrets/vicidial-mtls/client.crt
VICIDIAL_ADAPTER_CLIENT_KEY_FILE=/run/secrets/vicidial-mtls/client.key
VICIDIAL_ADAPTER_HMAC_FILE=/run/secrets/vicidial-adapter-hmac
VICIDIAL_ADAPTER_IDENTITY=codestra-middleware
VICIDIAL_ADAPTER_REQUIRED_SCOPE=telephony:provision

# Production activation remains a separate reviewed change.
VICIDIAL_WRITES_ENABLED=false
AGENT_SYNC_ENABLED=false
LEAD_PUBLICATION_ENABLED=false
LIVE_CALL_CONTROL_ENABLED=false
PRODUCTION_DIALING_ENABLED=false
EXTERNAL_COMMUNICATION_ENABLED=false
