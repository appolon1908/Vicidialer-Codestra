[Unit]
Description=Verify Codestra restricted VICIdial R3 operational contract
After=codestra-vicidial-restricted-adapter.service

[Service]
Type=oneshot
User=codestra-adapter
Group=codestra-adapter
WorkingDirectory=/opt/codestra/vicidial-restricted-adapter/current
ExecStart=/opt/codestra/vicidial-restricted-adapter/current/.venv/bin/python scripts/verify_operational_contract.py --base-url http://127.0.0.1:8097 --source-commit /opt/codestra/vicidial-restricted-adapter/current/SOURCE.COMMIT --attempts 1 --delay 0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
