# AMI remains loopback-only. Credentials are supplied through protected files.
CODESTRA_AMI_HOST=127.0.0.1
CODESTRA_AMI_PORT=5038
CODESTRA_AMI_USERNAME_FILE=/run/credentials/codestra-ami-event-gateway.service/ami-user
CODESTRA_AMI_SECRET_FILE=/run/credentials/codestra-ami-event-gateway.service/ami-secret
CODESTRA_AMI_OUTBOX=/var/lib/codestra-ami-event-gateway/events.sqlite3

# Delivery requires verified TLS and a dedicated client certificate.
CODESTRA_EVENT_ENDPOINT=https://10.40.0.1:9444/api/v1/telephony/events
CODESTRA_EVENT_CA_FILE=/etc/codestra/pki/ca.pem
CODESTRA_EVENT_CERT_FILE=/etc/codestra/pki/event-gateway.pem
CODESTRA_EVENT_KEY_FILE=/run/credentials/codestra-ami-event-gateway.service/tls-key
CODESTRA_EVENT_DELIVERY_ENABLED=false
