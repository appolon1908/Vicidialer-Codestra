[Unit]
Description=Codestra restricted VICIdial staging adapter
Documentation=file:/opt/codestra/vicidial-restricted-adapter/current/docs/ADAPTER_OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codestra-adapter
Group=codestra-adapter
WorkingDirectory=/opt/codestra/vicidial-restricted-adapter/current
EnvironmentFile=/etc/codestra/vicidial-restricted-adapter.env
Environment=PYTHONPATH=/opt/codestra/vicidial-restricted-adapter/current/src
LoadCredential=adapter-hmac:/etc/codestra/secrets/telephony-provisioning-hmac
LoadCredential=execution-grant-hmac:/etc/codestra/secrets/execution-grant-hmac
ExecStartPre=/opt/codestra/vicidial-restricted-adapter/current/.venv/bin/python scripts/validate_runtime.py
ExecStart=/opt/codestra/vicidial-restricted-adapter/current/.venv/bin/uvicorn codestra_vicidial.app:app --host 127.0.0.1 --port 8097 --no-server-header --proxy-headers --forwarded-allow-ips=127.0.0.1
ExecStartPost=/bin/sh -c 'for i in 1 2 3 4 5; do /usr/bin/curl --fail --silent --show-error http://127.0.0.1:8097/ready && exit 0; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
SyslogIdentifier=codestra-vicidial-restricted-adapter
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
UMask=0077
RuntimeDirectory=codestra-vicidial-restricted-adapter
RuntimeDirectoryMode=0700
StateDirectory=codestra-vicidial-restricted-adapter
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/run/credentials
ReadWritePaths=/var/lib/codestra-vicidial-restricted-adapter
LimitNOFILE=1024
TasksMax=64
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
